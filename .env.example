# Environment variables for local development (plan §7.7). Names only: copy this file to
# .env and fill it in, or run `scripts/init-env.sh`, which generates local-only values.
# Never commit .env. Phase 1 uses no secrets of real services.

# --- Next.js -----------------------------------------------------------------
# Set to 1: telemetry and agent feedback stay off (plan §10.2, row 10).
NEXT_TELEMETRY_DISABLED=

# --- Docker Compose: PostgreSQL 18 + PostGIS 3.6 -------------------------------
# Superuser of the local container (default: postgres).
POSTGRES_USER=
# Required by docker-compose.yml. Local only.
POSTGRES_PASSWORD=
# Host port on 127.0.0.1 (default: 5432).
POSTGRES_PORT=

# --- Databases -----------------------------------------------------------------
# Compose creates both databases empty from template0 on first start
# (docker/postgres/*.sql); CI and cloud sessions create the test database the same way.
# Development database `wingchunroots` (used from M01).
DATABASE_URL=
# Disposable test database `wingchunroots_test`: scripts/verify.sh, db-env-check,
# integration tests and `pnpm db:reset` run against it. Cloud sessions get it from
# scripts/cloud-setup.sh.
TEST_DATABASE_URL=
# Passwords of the database roles (plan §6.2, from M01). scripts/db-bootstrap.sh creates the
# roles with them, once per environment and database (scripts/init-env.sh generates local
# values; cloud sessions and CI use throwaway ones). The application connects as app_rw and
# app_public_ro to the host and database of DATABASE_URL; migrations run as migrator.
DB_MIGRATOR_PASSWORD=
DB_APP_RW_PASSWORD=
DB_APP_PUBLIC_RO_PASSWORD=

# --- Accounts (from M02) -----------------------------------------------------------
# Public origin of the app, used for the links in e-mail and the trusted origin of the auth and
# API endpoints (default: http://localhost:3000; E2E runs set it to http://127.0.0.1:<E2E_PORT>).
APP_URL=
# Better Auth secret: signs the session cookies and encrypts the TOTP secrets. Local only;
# scripts/init-env.sh generates it. Changing it signs everyone out and makes stored TOTP secrets
# unreadable.
BETTER_AUTH_SECRET=
# Key of ip_hmac = HMAC-SHA-256(key, IP) in the audit log and the sessions (plan §6.2, §6.4).
# Local only; scripts/init-env.sh generates it. Rotated yearly once hosting exists.
IP_HMAC_KEY=
# Key that seals the links of account e-mails (confirmation, password reset) inside the job queue,
# so pgboss.job never holds a token in clear (AES-256-GCM). The app and the worker need the same
# value. Local only; scripts/init-env.sh generates it. Changing it fails the e-mails still queued.
MAIL_SEAL_KEY=
# Reverse proxies in front of the app: comma-separated IP addresses or CIDR ranges. The client
# address is the first X-Forwarded-For entry from the right that is not one of them. Empty without
# a proxy (local, CI); required in production behind a public APP_URL (docs/adr/0004-auth.md).
TRUSTED_PROXIES=
# --- Internal cache revalidation (from M09) ------------------------------------------------
# The worker asks the web process to drop its public cache after it recomputes the lineage
# counters: POST <INTERNAL_APP_URL or APP_URL>/api/internal/revalidate with this shared secret
# (32+ characters). Empty: derived from MAIL_SEAL_KEY, which the app and the worker share already.
# INTERNAL_APP_URL is the web process inside the Compose network (M12); empty: APP_URL.
INTERNAL_REVALIDATE_SECRET=
INTERNAL_APP_URL=
# Test-only credentials of the seeded demo accounts (`pnpm db:seed`, never with
# NODE_ENV=production): the password of every demo account and the TOTP secret of the demo staff
# accounts (demo-admin, demo-archivist, demo-moderator), in Better Auth's raw form (40 hex
# characters): an authenticator app takes the base32 encoding of its bytes
# (docs/guides/admin-guide.bg.md). Local and CI only.
E2E_PASSWORD=
E2E_TOTP_SECRET=

# --- Mailpit (e-mail) ---------------------------------------------------------
# Host ports on 127.0.0.1 (defaults: 1025 for SMTP, 8025 for the web UI).
MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=

# --- E-mail sending (from M01b) ---------------------------------------------------
# Transport of the worker's Mailer: smtp (the Mailpit above; scripts/init-env.sh sets it) or file
# (each message is written to MAIL_FILE_DIR; the default, used by cloud sessions). Phase 1 has no
# real mail provider, so no e-mail leaves the machine.
MAIL_TRANSPORT=
# SMTP server for MAIL_TRANSPORT=smtp (default: smtp://127.0.0.1:<MAILPIT_SMTP_PORT>). Phase 1 accepts
# only the local Mailpit: a loopback address, localhost or the Compose service name mailpit.
SMTP_URL=
# Directory of the file transport (default: .mail in the repository, git-ignored).
MAIL_FILE_DIR=
# Sender (default: WingChunRoots <no-reply@wingchunroots.test>).
MAIL_FROM=
# Mailpit API that e2e/helpers/mailbox.ts reads (default: http://127.0.0.1:<MAILPIT_UI_PORT>).
MAILPIT_URL=

# --- SeaweedFS (S3-compatible object storage) ------------------------------------
# Host port on 127.0.0.1 (default: 8333).
S3_PORT=
# Local-only credentials of the SeaweedFS S3 admin identity. Required by docker-compose.yml.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket names (defaults: wcr-evidence, wcr-media).
S3_BUCKET_EVIDENCE=
S3_BUCKET_MEDIA=
# M10a: the S3 service the evidence store uses, an origin only, for example http://127.0.0.1:8333
# (the SeaweedFS above). Local hosts only in Phase 1 (plan §3.3). Empty: the filesystem store.
S3_ENDPOINT=
# Signature region (default: us-east-1; SeaweedFS ignores it).
S3_REGION=

# --- Evidence store (M10a, docs/evidence-and-review.md) --------------------------
# filesystem or s3 (default: s3 when S3_ENDPOINT is set, otherwise filesystem).
EVIDENCE_STORAGE=
# Private folder of the filesystem store (default: .storage/evidence, git-ignored; never in public/).
EVIDENCE_STORAGE_DIR=

# --- Profile photo store (M14, docs/adr/0016-profile-photos.md) ------------------
# filesystem or s3 (default: EVIDENCE_STORAGE, then s3 when S3_ENDPOINT is set, otherwise
# filesystem). The S3 store uses S3_BUCKET_MEDIA, never the evidence bucket.
MEDIA_STORAGE=
# Folder of the filesystem store (default: .storage/photos, git-ignored; never in public/ and
# never inside or around EVIDENCE_STORAGE_DIR).
MEDIA_STORAGE_DIR=

# --- School map (milestone M11) -------------------------------------------------
# local: the map uses the minimal styles in public/map-styles/ (no tiles, no external request)
# instead of OpenFreeMap's. The E2E build always uses them. Empty: OpenFreeMap.
MAP_STYLES=

# --- Billing in test mode (milestone M22, docs/adr/0025-billing.md) -----------------------
# No real charge is ever made. BILLING_PROVIDER: test (the default; the app's own test provider,
# the only one CI uses) or stripe (Stripe test mode, only with the two values below).
BILLING_PROVIDER=
# HMAC key of the test provider's events (32+ characters); the app and the worker need the same
# value. Local only; scripts/init-env.sh generates it. Empty: derived from MAIL_SEAL_KEY.
BILLING_TEST_WEBHOOK_SECRET=
# Only with BILLING_PROVIDER=stripe: a Stripe *test* secret key (sk_test_...; a live key is refused
# at start, whatever the provider) and the signing secret of the test webhook endpoint (whsec_...),
# for example from `stripe listen --forward-to <APP_URL>/api/billing/webhook`. Never commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Playwright ------------------------------------------------------------------
# pnpm e2e reads these three from the environment; scripts/verify.sh also takes them from .env.
# Port of the `next start` server used by E2E tests (default: 3100).
E2E_PORT=
# Only when the pinned Playwright expects a different Chromium build than the installed one
# (Claude cloud sessions set it automatically, plan §7.6).
PW_CHROMIUM_EXECUTABLE=
# Parallel E2E workers (default: Playwright's, half the CPU cores). 2 on a slower machine, for
# example Windows with Docker Desktop, where more workers overrun the proxy's 500 ms person check.
PW_WORKERS=

# --- Test fault switch (milestone M04) -------------------------------------------
# lineage-once: a request with the test fault cookie fails its first lineage read once, for the
# E2E test of the error state with Retry. Honoured only when APP_URL is a loopback address; the
# server refuses to start with it otherwise (docs/api/lineage.md). Leave empty; playwright.config.ts
# sets it for the E2E server.
WCR_TEST_FAULTS=

# --- Production-like local run, logs and archives (M12, docs/operations/) -----------------
# Host port of the Compose `app` profile's web service on 127.0.0.1 (default: 3000). Change APP_URL
# with it.
APP_PORT=
# Log level of the pino JSON lines: fatal, error, warn, info, debug or trace (default: info).
LOG_LEVEL=
# Folder of the local archives of scripts/backup-local.sh (default: backups, git-ignored): an
# absolute path or one relative to the repository (no ~). The Compose web service mounts the same
# folder read-only at /backups for /admin/system.
BACKUP_DIR=
# Archives kept per database (default: 14).
BACKUP_KEEP=
# Folder of the erasure ledger (default: erasures/ inside the backup folder): ids and times of every
# account erasure and trial lesson withdrawal, written before the change, so that
# `pnpm erasures:replay` can repeat them on a restored copy. An absolute path or one relative to the
# repository. An erasure is refused while the folder cannot be written. Keep it with the archives.
ERASURE_LEDGER_DIR=
# Optional encryption of the archive with age (https://age-encryption.org): the public key(s) of
# the recipient, `age1…`, several separated by spaces. When it is set and `age` is on PATH,
# scripts/backup-local.sh writes <name>.dump.age (and objects/<name>.tar.age with --objects); empty:
# a plain archive. The matching private key never belongs on the server.
BACKUP_AGE_RECIPIENT=
# Only for scripts/restore-drill.sh on an encrypted archive: the path of the age identity file (the
# private key). Give it when you run the drill, from a machine that holds the key; leave it empty on
# the server. Without it an encrypted archive makes the drill stop with FAIL.
BACKUP_AGE_IDENTITY=
# The database container in which scripts/backup-local.sh and scripts/restore-drill.sh run pg_dump
# and pg_restore (their version must be the server's). Empty: the running Compose `postgres`
# service, else the tools on PATH (cloud session). CI sets the service container's id.
PG_CONTAINER=
# Where the restore drill restores: container (a temporary database container; the default with
# Docker Compose) or server (a temporary database on the same server; the default otherwise).
DRILL_TARGET=
# The longest restore the drill accepts, in seconds (default: 14400 = 4 h; DEFAULT D24).
RESTORE_RTO_SECONDS=
