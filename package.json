{
  "name": "wingchunroots",
  "version": "0.0.0",
  "private": true,
  "description": "WingChunRoots: verified Wing Chun teaching lineages, school finder and training passport.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.mts",
    "e2e": "playwright test",
    "screenshots": "PW_SCREENSHOTS=1 playwright test --project screenshots",
    "bench:layout": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bench-layout.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/cli.ts migrate",
    "db:seed": "tsx src/server/db/cli.ts seed",
    "db:reset": "tsx src/server/db/cli.ts reset",
    "db:check": "tsx src/server/db/cli.ts check",
    "admin:create": "tsx src/server/auth/cli.ts",
    "fixtures:generate": "tsx src/fixtures/cli.ts",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "notices": "tsx scripts/generate-notices.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "mail:check": "tsx src/server/jobs/cli.ts mail-check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/gloock": "5.3.0",
    "@fontsource/noto-serif-display": "5.3.0",
    "@orpc/openapi": "1.15.7",
    "@orpc/server": "1.15.7",
    "@react-email/render": "2.1.0",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "elkjs": "0.12.0",
    "next": "16.4.1",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.2",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "chrome-launcher": "1.2.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
