# What the application image's build never sees (Dockerfile; milestone M12). Secrets first: no
# .env of any kind reaches the build context, only .env.example (names only).
.env*
!.env.example
*.pem

# Local data and results: archives, evidence, e-mail, logs, browser runs.
backups/
.storage/
.mail/
.data/
.verify/
test-results/
playwright-report/
blob-report/
coverage/
.lighthouseci/

# Built or installed inside the image.
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Not needed to build or run the app.
.git/
.github/
.claude/
docs/
e2e/**/*.png
